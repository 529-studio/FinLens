# FinSight Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# DO NOT COMMIT .env TO VERSION CONTROL.

# AI Engine Daemon Host & Port
FINSIGHT_DAEMON_HOST=127.0.0.1
FINSIGHT_DAEMON_PORT=8765

# Inference Mode: "local" or "cloud"
FINSIGHT_INFERENCE_MODE=local

# Local VLM Settings (macOS Apple Silicon MLX / Windows CUDA)
FINSIGHT_LOCAL_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct-4bit
FINSIGHT_LOCAL_DEVICE=auto

# Cloud BYOK API Keys (Used when FINSIGHT_INFERENCE_MODE=cloud)
# Leave blank if using full local mode
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Document Processing & Storage
FINSIGHT_STORAGE_DIR=~/.finsight/data
FINSIGHT_LANCEDB_PATH=~/.finsight/lancedb
FINSIGHT_PDF_RENDER_DPI=150
