<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- JIT compilation required for V8 / WebKit in desktop webview -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Unsigned executable memory required for MLX / Python daemon runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow outgoing network connections for Cloud Router BYOK and update checks -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow incoming network connections for local IPC daemon on 127.0.0.1:8765 -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Allow reading and writing user-selected PDF files via open file dialog -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
