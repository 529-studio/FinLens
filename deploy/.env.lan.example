# ==============================================================================
# FinTrace Enterprise LAN Deployment Configuration Template
# Governed by 529 Engineering Standards (Rule 2: Zero-Leak Security Policy)
# ==============================================================================

# Port to expose on the local network (LAN)
LAN_PORT=8080

# Cryptographically generated session / secret key (generated via setup-lan.sh)
FINTRACE_SECRET_KEY=CHANGE_ME_CRYPTOGRAPHIC_SECRET_KEY

# Inference mode: 'cloud' (recommended for LAN box) or 'auto'
FINTRACE_INFERENCE_MODE=cloud

# Cloud BYOK Credentials (Keys are kept strictly on LAN and never leave internal network)
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
