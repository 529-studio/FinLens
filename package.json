{
  "name": "finsight-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FinSight — Visual Financial RAG & Hybrid Desktop/Excel Platform",
  "scripts": {
    "dev:desktop": "npm run --prefix apps/desktop dev",
    "dev:engine": "python3 packages/core-engine/src/main.py",
    "dev:addin": "npm run --prefix packages/office-addin dev",
    "bench:recall": "python3 benchmarks/eval_retrieval.py",
    "lore:status": "lore status",
    "lore:ingest": "lore ingest",
    "lore:verify": "lore verify",
    "harvest:lessons": "bash ~/repos/529-engineering-skills/scripts/harvest-lessons.sh"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
